@baseUrl = http://localhost:5000
@project_name = svs_spring_demo
@run_id = jizlsez2
@step = 49

### get projects
GET {{baseUrl}}/api/projects

### get project runs
GET {{baseUrl}}/api/{{project_name}}/runs

### set project
POST {{baseUrl}}/api/update-project/{{project_name}}

### set run
POST {{baseUrl}}/api/update-run/{{project_name}}/{{run_id}}

### get run history
GET {{baseUrl}}/api/{{project_name}}/{{run_id}}/history

### get visualization data
GET {{baseUrl}}/api/{{project_name}}/{{run_id}}/visualize

### get weight connections
GET {{baseUrl}}/api/{{project_name}}/{{run_id}}/{{step}}/weight_connections

### get status
GET {{baseUrl}}/api/status
